.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
.npmrc
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
*secret*.json
*token*.json
secrets/
.secrets/
# airouter connection settings must never be copied into this repo
ar.env

