# Copy to .env (git-ignored) and fill in locally. Never commit real values.
#
# Both variables are read at BUILD time and embedded into the static HTML,
# so they are public. Do not put secrets or tokens in NEXT_PUBLIC_* vars.

# Canonical public URL used for OG/meta tags (e.g. the live www domain).
NEXT_PUBLIC_SITE_URL=

# Contact email shown on the site (falls back to the value in app/_data/site.ts).
NEXT_PUBLIC_CONTACT_EMAIL=info@firstrec.com.au

# Optional tooling variables (non-secret, usually leave unset):
# CODEX_SANDBOX=
# WRANGLER_LOG_PATH=
# WRANGLER_WRITE_LOGS=
# MINIFLARE_REGISTRY_PATH=
